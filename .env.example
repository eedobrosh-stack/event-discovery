# Database
DATABASE_URL=sqlite:///./data/events.db

# API Keys - Primary Sources
EVENTBRITE_TOKEN=
TICKETMASTER_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_SECRET=
PREDICTHQ_TOKEN=

# Optional Enrichment
YOUTUBE_API_KEY=

# Google OAuth (for Sheets export)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Gemini (LLM extractor for Route 1, plus CSE classifier in Q2 hybrid mode)
GEMINI_API_KEY=

# Google Programmable Search Engine (Route 1 Cadence B — hybrid CSE + LLM)
# Setup, one-time:
#   1. Visit https://programmablesearchengine.google.com/, create an
#      engine set to "search the entire web", copy its ID into the line
#      below.
#   2. In Google Cloud Console, enable "Custom Search API" for the same
#      project that owns GEMINI_API_KEY (or set GOOGLE_API_KEY below if
#      you use a separate key for CSE).
# When unset, discovery falls back to the original Gemini-grounded path
# that asks Gemini to generate URLs (more hallucinations).
GOOGLE_CSE_ID=
# GOOGLE_API_KEY=    # only set if your CSE key differs from GEMINI_API_KEY

# Discovery method override. Auto-detects 'cse' when GOOGLE_CSE_ID is set,
# else 'gemini'. Force one explicitly with cse | gemini.
# DISCOVERY_METHOD=

# Scheduling
SCRAPE_INTERVAL_HOURS=6
CLEANUP_DAYS_AGO=7

# Rate Limiting
RATE_LIMIT_PER_SECOND=2
