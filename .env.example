# Database
DATABASE_URL=sqlite:///./data/events.db

# API Keys - Primary Sources
EVENTBRITE_TOKEN=
TICKETMASTER_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_SECRET=
PREDICTHQ_TOKEN=

# Optional Enrichment
YOUTUBE_API_KEY=

# Google OAuth (for Sheets export)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Gemini (LLM extractor for Route 1, plus search-classifier in Q2 hybrid mode)
GEMINI_API_KEY=

# Brave Search API (Route 1 Cadence B — hybrid search + LLM-classifier)
# Setup, one-time:
#   1. Sign up at https://api.search.brave.com/ — free tier is 2k
#      queries/month, paid plans from $3/1k.
#   2. Copy the API key into BRAVE_API_KEY below.
# When unset, discovery falls back to the original Gemini-grounded path
# that asks Gemini to generate URLs from scratch (more hallucinations).
BRAVE_API_KEY=

# Discovery method override. Auto-detects 'search' when BRAVE_API_KEY is set,
# else 'gemini'. Force one explicitly with search | gemini.
# DISCOVERY_METHOD=

# Scheduling
SCRAPE_INTERVAL_HOURS=6
CLEANUP_DAYS_AGO=7

# Rate Limiting
RATE_LIMIT_PER_SECOND=2
