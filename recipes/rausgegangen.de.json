{
  "recipe_version": 1,
  "domain": "rausgegangen.de",
  "source_name": "rausgegangen",
  "country": "Germany",
  "city_name": "Berlin",
  "timezone": "Europe/Berlin",
  "language": "de",
  "priority": 40,
  "enabled": false,
  "entry": {
    "urls": [],
    "template": "https://rausgegangen.de/en/eventsearch/?city={value}",
    "values": [
      "berlin",
      "hamburg",
      "muenchen",
      "koeln",
      "frankfurt",
      "leipzig",
      "stuttgart",
      "duesseldorf"
    ],
    "paginate": {
      "mode": "page_param",
      "param": "page",
      "start": 1,
      "max_pages": 15
    }
  },
  "fetch": {
    "delay_seconds": 2.5,
    "timeout": 30,
    "impersonate": true
  },
  "parse": {
    "kind": "html",
    "item": "[data-testid=\"event-tile-wide\"]",
    "fields": {
      "source_id": {
        "sel": "a[href^=\"/en/events/\"]",
        "attr": "href",
        "regex": "/en/events/([^/?#]+)"
      },
      "name": "span.h6",
      "start_date": {
        "sel": "span.font-bold",
        "regex": "^[A-Za-z]{2},\\s*(\\d{1,2}\\.\\s*[A-Za-zä]+)"
      },
      "start_time": {
        "sel": "span.font-bold + span",
        "regex": "(\\d{1,2}:\\d{2})"
      },
      "venue_name": {
        "sel": "p.text-neutral",
        "regex": "^(.*?)\\s*\\|"
      },
      "venue_city": {
        "sel": "p.text-neutral",
        "regex": "\\|\\s*(.+?)\\s*$"
      },
      "price": {
        "sel": ".text-primary",
        "regex": "(\\d+(?:[.,]\\d{2})?)\\s*€"
      },
      "purchase_link": {
        "sel": "a[href^=\"/en/events/\"]",
        "attr": "href",
        "absolute": true
      },
      "image_url": {
        "sel": "img",
        "attr": "src",
        "absolute": true
      }
    }
  },
  "defaults": {
    "price_currency": "EUR"
  },
  "notes": "DISABLED pending a second authoring session. Fetch works only with fetch.impersonate (plain httpx → 403). Blocker: the default /en/eventsearch/?city=X list mixes far-future promo tiles and shows dates without a year ('Mi, 16. Okt |'); the weekday does not match 2026 for many tiles, so year inference is unsafe, and event pages carry no JSON-LD. Next step: find the date-filtered search URL (browser Network tab) or a tile attribute with an ISO date, then add a weekday consistency check before enabling. Selectors below are verified against the tile markup (data-testid=event-tile-wide)."
}
