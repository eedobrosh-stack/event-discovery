  "recipe_version": 1,
  "country": "Israel",
  "city_name": "Tel Aviv",
  "language": "he",
  "timezone": "Asia/Jerusalem",
  "domain": "kartisim.net",
  "source_name": "kartisim_net",
  "priority": 35,
  "cadence_hours": 48,
  "entry": {
    "urls": [
      "https://kartisim.net/section/music-shows",
      "https://kartisim.net/section/theater",
      "https://kartisim.net/section/standup",
      "https://kartisim.net/section/children-shows",
      "https://kartisim.net/section/live-shows",
      "https://kartisim.net/section/musicals",
      "https://kartisim.net/section/opera-concerts",
      "https://kartisim.net/section/dance-ballet",
      "https://kartisim.net/section/world-concerts",
      "https://kartisim.net/section/festivals",
      "https://kartisim.net/section/night-life"
    ],
    "paginate": {
      "mode": "page_param",
      "param": "page",
      "max_pages": 3
    },
    "follow": {
      "selector": "a[href*='kartisim.net/event/']",
      "regex": "^(https://kartisim\\.net/event/[^/?#]+)/?$",
      "max_links": 300
    }
  },
  "fetch": {
    "delay_seconds": 1.5,
    "timeout": 40,
    "headers": {
      "Accept-Language": "he,en;q=0.8"
    }
  },
  "parse": {
    "kind": "html",
    "item": "table tbody tr[onclick*='/go/event-date/']",
    "date_format": "%d/%m/%Y",
    "page_fields": {
      "name": "h1",
      "image_url": {
        "sel": "meta[property='og:image']",
        "attr": "content"
      },
      "description": {
        "sel": "script[type='application/ld+json']",
        "index": 1,
        "regex": "\"description\":\\s*\"([^\"]+)\""
      }
    },
    "fields": {
      "start_date": {
        "sel": "td",
        "index": 1,
        "regex": "(\\d{2}/\\d{2}/\\d{4})"
      },
      "start_time": {
        "sel": "td",
        "index": 2,
        "regex": "(\\d{1,2}:\\d{2})"
      },
      "venue_name": {
        "sel": "td",
        "index": 3
      },
      "venue_address": {
        "sel": "td",
        "index": 4
      },
      "venue_city": {
        "sel": "td",
        "index": 5
      },
      "purchase_link": {
        "sel": "a[href*='/go/event-date/']",
        "attr": "href",
        "absolute": true
      },
      "source_id": {
        "sel": "a[href*='/go/event-date/']",
        "attr": "href",
        "regex": "/go/event-date/(\\d+)"
      }
    }
  },
  "defaults": {
    "venue_country": "Israel",
    "price_currency": "ILS"
  },
