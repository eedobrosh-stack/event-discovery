{
  "recipe_version": 1,
  "domain": "goshow.co.il",
  "source_name": "goshow_co_il",
  "country": "Israel",
  "city_name": "Tel Aviv",
  "language": "he",
  "timezone": "Asia/Jerusalem",
  "priority": 40,
  "cadence_hours": 48,
  "entry": {
    "urls": [
      "https://www.goshow.co.il/event/category/music",
      "https://www.goshow.co.il/event/category/standup",
      "https://www.goshow.co.il/event/category/kids",
      "https://www.goshow.co.il/event/category/shows",
      "https://www.goshow.co.il/event/category/lectures",
      "https://www.goshow.co.il/event/category/festivals",
      "https://www.goshow.co.il/event/category/misc"
    ],
    "paginate": {
      "mode": "page_param",
      "param": "page",
      "max_pages": 10
    }
  },
  "fetch": {
    "method": "POST",
    "body_format": "form",
    "body": {
      "page": "{page}"
    },
    "delay_seconds": 1.5,
    "timeout": 30,
    "headers": {
      "Accept-Language": "he,en;q=0.8",
      "X-Requested-With": "XMLHttpRequest"
    }
  },
  "parse": {
    "kind": "html",
    "item": "li:has(.resultData)",
    "date_format": "%d.%m.%Y",
    "fields": {
      "name": ".resultData .resultLiText a",
      "artist_name": ".resultData .resultLiText a",
      "purchase_link": {
        "sel": ".resultData .resultLiText a",
        "attr": "href",
        "absolute": true
      },
      "source_id": {
        "sel": ".resultData .resultLiText a",
        "attr": "href",
        "regex": "/event/(\\d+/\\d+)"
      },
      "description": ".resultData .resultLiText p",
      "image_url": {
        "sel": ".resultLiImg img",
        "attr": "src",
        "absolute": true
      },
      "venue_name": {
        "sel": ".closeShowTitleNew",
        "regex": "^\\s*([^,]+?)\\s*(?:,|$)"
      },
      "venue_city": {
        "sel": ".closeShowTitleNew",
        "regex": ",\\s*([^,]+?)\\s*$"
      },
      "start_date": {
        "sel": ".closeShowDateNew",
        "regex": "(\\d{1,2}\\.\\d{1,2}\\.\\d{4})"
      },
      "start_time": {
        "sel": ".closeShowDateNew",
        "regex": "(\\d{1,2}:\\d{2})"
      }
    }
  },
  "defaults": {
    "venue_country": "Israel",
    "price_currency": "ILS"
  },
  "city_aliases": {
    "תל אביב-יפו": "Tel Aviv",
    "תל אביב יפו": "Tel Aviv",
    "תל אביב": "Tel Aviv",
    "תל-אביב": "Tel Aviv",
    "ת\"א": "Tel Aviv",
    "ירושלים": "Jerusalem",
    "חיפה": "Haifa",
    "באר שבע": "Beersheba",
    "באר-שבע": "Beersheba",
    "נתניה": "Netanya",
    "הרצליה": "Herzliya",
    "רמת גן": "Ramat Gan",
    "רמת-גן": "Ramat Gan",
    "ראשון לציון": "Rishon LeZion",
    "ראשון-לציון": "Rishon LeZion",
    "פתח תקווה": "Petah Tikva",
    "פתח-תקווה": "Petah Tikva",
    "כפר סבא": "Kfar Saba",
    "רחובות": "Rehovot",
    "מודיעין": "Modiin",
    "רעננה": "Raanana",
    "חולון": "Holon",
    "אילת": "Eilat",
    "אשדוד": "Ashdod",
    "אשקלון": "Ashkelon",
    "גבעתיים": "Givatayim",
    "בת ים": "Bat Yam",
    "הוד השרון": "Hod HaSharon",
    "רמת השרון": "Ramat HaSharon",
    "קרית אונו": "Kiryat Ono",
    "לוד": "Lod",
    "רמלה": "Ramla",
    "יבנה": "Yavne",
    "נס ציונה": "Ness Ziona",
    "ראש העין": "Rosh HaAyin",
    "שוהם": "Shoham",
    "יהוד": "Yehud",
    "טבריה": "Tiberias",
    "עפולה": "Afula",
    "נהריה": "Nahariya",
    "כרמיאל": "Karmiel",
    "עכו": "Acre",
    "צפת": "Safed",
    "חדרה": "Hadera",
    "פרדס חנה": "Pardes Hanna",
    "זכרון יעקב": "Zichron Yaakov",
    "בנימינה": "Binyamina",
    "קיסריה": "Israel - Other",
    "בית שמש": "Beit Shemesh",
    "קרית גת": "Kiryat Gat",
    "קרית מוצקין": "Kiryat Motzkin",
    "קרית ביאליק": "Kiryat Bialik",
    "קרית ים": "Kiryat Yam",
    "קרית שמונה": "Kiryat Shmona",
    "יקנעם": "Yokneam",
