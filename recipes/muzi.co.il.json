{
  "recipe_version": 1,
  "country": "Israel",
  "city_name": "Tel Aviv",
  "language": "he",
  "timezone": "Asia/Jerusalem",
  "domain": "muzi.co.il",
  "source_name": "muzi_co_il",
  "priority": 45,
  "cadence_hours": 24,
  "entry": {
    "urls": [
      "https://muzi.co.il/events-by-date/"
    ],
    "paginate": {
      "mode": "page_param",
      "param": "paged",
      "max_pages": 80
    }
  },
  "fetch": {
    "delay_seconds": 1.5,
    "timeout": 40,
    "headers": {
      "Accept-Language": "he,en;q=0.8"
    }
  },
  "parse": {
    "kind": "html",
    "item": "div.event.type-event:not(:has(.events-blocks-promotion))",
    "fields": {
      "name": ".avatar-name a",
      "purchase_link": {
        "sel": ".avatar-name a",
        "attr": "href",
        "absolute": true
      },
      "source_id": {
        "sel": ".avatar-name a",
        "attr": "href",
        "regex": "/event/([^/?#]+)/?$"
      },
      "start_time": {
        "sel": ".avatar-time p",
        "regex": "(\\d{1,2}:\\d{2})"
      },
      "price": {
        "sel": ".avatar-cost p",
        "regex": "(\\d[\\d,]*)"
      },
      "raw_categories": {
        "attr": "class",
        "regex": "events_by_genre-([\\w-]+)"
      }
    }
  },
  "detail": {
    "url_field": "purchase_link",
    "max_per_run": 250,
    "only_new": true,
    "overwrite": [
      "purchase_link"
    ],
    "parse": {
      "kind": "html",
      "fields": {
        "start_date": {
          "sel": "script[type='application/ld+json']",
          "all": true,
          "join": " ",
          "regex": "\"startDate\":\\s*\"(\\d{4}-\\d{2}-\\d{2})"
        },
        "venue_name": {
          "sel": "script[type='application/ld+json']",
          "all": true,
          "join": " ",
          "regex": "\"location\":\\s*\\{[^}]*?\"name\":\\s*\"([^\"]+)\""
        },
        "venue_city": {
          "sel": "script[type='application/ld+json']",
          "all": true,
          "join": " ",
          "regex": "\"addressLocality\":\\s*\"([^\"]+)\""
        },
        "artist_name": {
          "sel": "script[type='application/ld+json']",
          "all": true,
          "join": " ",
          "regex": "\"performer\":\\s*\\{[^}]*?\"name\":\\s*\"([^\"]+)\""
        },
        "purchase_link": {
          "sel": "#popupWindowBox a[href^='http']",
          "attr": "href"
        }
      }
    }
  },
  "defaults": {
    "venue_country": "Israel",
    "price_currency": "ILS"
  },
